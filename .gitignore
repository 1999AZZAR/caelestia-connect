/build/
/dist/
/rust-daemon/target/
/develop-eggs/
/eggs/
/.eggs/
*.egg-info/
*.egg
/wheels/
/pip-wheel-metadata/
/installed.cfg
/MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments and local Python configuration
.venv/
.venv-*/
venv/
venv-*/
env/
ENV/
.python-version

# Test, coverage, lint and type-check caches
.pytest_cache/
.ruff_cache/
